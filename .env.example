# Required — the run will fail without these
ANTHROPIC_API_KEY=sk-ant-...
SERPER_API_KEY=...

# Optional — code degrades gracefully if missing (per test_run.py's own docstring)
PROXYCURL_API_KEY=...
WAPPALYZER_API_KEY=...
BRAVE_API_KEY=...

# Optional — used by contact_research_crew but NOT read via Settings, reads
# straight from the OS environment (os.getenv), so it still needs to be in
# .env for it to pick it up locally
HUNTER_API_KEY=...