FROM --platform=linux/amd64 python:3.12-slim

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app

COPY pyproject.toml .
COPY uv.lock* .

RUN uv sync --frozen --no-dev

COPY agent/ ./agent/
COPY api/ ./api/

RUN mkdir -p /data

ENV DATABASE_URL="sqlite+aiosqlite:////data/sales_agent.db"
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

CMD ["uv", "run", "python", "-m", "api.worker"]